{
  "manifest_version": 3,
  "name": "New Tab",
  "short_name": "New Tab",
  "version": "1.1.0",
  "description": "Customize your new tab with images, animated GIFs, and video wallpapers.",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Personalize new tab"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
